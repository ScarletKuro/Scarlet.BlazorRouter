<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>

    <!-- Required by the vendored Routing/Components/RouteContext.cs, which is [SkipLocalsInit]. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>true</IsPackable>
    <Authors>ScarletKuro</Authors>
    <Description>Explicit route-based Blazor router that uses a provided route list instead of assembly scanning.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/ScarletKuro/Scarlet.BlazorRouter</RepositoryUrl>
    <PackageTags>Blazor, Router, Routing, ASP.NET Core, Components</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!--
      Routing/ holds ASP.NET Core routing sources compiled straight into this assembly. The COMPONENTS
      symbol is what upstream uses to build those same files into Microsoft.AspNetCore.Components.dll:
      it makes every type internal and strips the HttpContext/IRouter/ObjectPool code paths, which is
      how we avoid a Microsoft.AspNetCore.Routing package reference. See tools/sync-aspnetcore-routing.ps1.
    -->
    <DefineConstants>$(DefineConstants);COMPONENTS</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
    <PackageReference Include="Nerdbank.GitVersioning" Version="3.10.91" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="icon.png" Pack="true" PackagePath="\" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
